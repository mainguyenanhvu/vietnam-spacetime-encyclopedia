{
  "name": "vietnam-spacetime-encyclopedia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Từ điển bách khoa Việt Nam theo không gian–thời gian trên bản đồ tương tác",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build_sado_index.mjs && tsc && vite build",
    "preview": "vite preview",
    "build:index": "node scripts/build_sado_index.mjs && node scripts/build_catalog.mjs && node scripts/build_entries_index.mjs",
    "validate": "node scripts/run_validators.mjs",
    "smoke": "node --experimental-websocket scripts/smoke.mjs",
    "verify:chuquyen": "node --experimental-websocket scripts/verify_chu_quyen.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.1",
    "typescript": "^5.6.3",
    "vite": "6.4.3"
  }
}
